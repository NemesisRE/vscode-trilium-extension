    "onStartupFinished",
    "onChatParticipant:trilium-notes.trilium",
    "onLanguageModelTool:trilium_createNote",
    "onLanguageModelTool:trilium_importNotes",
    "onLanguageModelTool:trilium_searchNotes",
    "onLanguageModelTool:trilium_stageDraftNotes",
    "onLanguageModelTool:trilium_getNoteContext",
    "onLanguageModelTool:trilium_readNote",
