{
  "name": "trilium-notes",
  "displayName": "Trilium Notes",
  "description": "%extension.description%",
  "version": "2.0.2",
  "publisher": "NemesisRE",
  "icon": "media/icon.png",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/NemesisRE/vscode-trilium-extension#readme",
  "bugs": {
    "url": "https://github.com/NemesisRE/vscode-trilium-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NemesisRE/vscode-trilium-extension"
  },
  "files": [
    "out/extension.js",
    "out/ckeditor/**",
    "out/webviews/**",
    "out/boxicons/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "trilium",
    "trilium-notes",
    "notes",
    "knowledge-base",
    "pkm",
    "zettelkasten",
    "etapi"
  ],
  "engines": {
    "vscode": "^1.138.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "trilium.textEditor",
        "displayName": "%customEditor.trilium.textEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.trilium-text"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trilium",
          "title": "%viewsContainer.trilium.title%",
          "icon": "media/trilium.svg"
        }
      ]
    },
    "views": {
      "trilium": [
        {
          "id": "triliumNoteTree",
          "name": "%view.triliumNoteTree.name%",
          "icon": "media/trilium.svg",
          "contextualTitle": "%view.triliumNoteTree.contextualTitle%"
        },
        {
          "id": "triliumNoteAttributes",
          "name": "%view.triliumNoteAttributes.name%",
          "type": "webview",
          "icon": "media/trilium.svg",
          "contextualTitle": "%view.triliumNoteAttributes.contextualTitle%"
        },
        {
          "id": "triliumRecentNotes",
          "name": "%view.triliumRecentNotes.name%",
          "icon": "media/trilium.svg",
          "contextualTitle": "%view.triliumRecentNotes.contextualTitle%"
        },
        {
          "id": "triliumBacklinks",
          "name": "%view.triliumBacklinks.name%",
          "icon": "media/trilium.svg",
          "contextualTitle": "%view.triliumBacklinks.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "trilium.refresh",
        "title": "%command.trilium_refresh.title%",
        "icon": "$(refresh)",
        "category": "Trilium"
      },
      {
        "command": "trilium.connect",
        "title": "%command.trilium_connect.title%",
        "icon": "$(debug-disconnect)",
        "category": "Trilium"
      },
      {
        "command": "trilium.reconnect",
        "title": "%command.trilium_reconnect.title%",
        "icon": "$(database)",
        "category": "Trilium"
      },
      {
        "command": "trilium.disconnect",
        "title": "%command.trilium_disconnect.title%",
        "icon": "$(debug-disconnect)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNote",
        "title": "%command.trilium_openNote.title%",
        "icon": "$(edit)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNoteAsHtml",
        "title": "%command.trilium_openNoteAsHtml.title%",
        "icon": "$(file-code)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNoteAsMarkdown",
        "title": "%command.trilium_openNoteAsMarkdown.title%",
        "icon": "$(markdown)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNote",
        "title": "%command.trilium_createNote.title%",
        "icon": "$(add)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openInBrowser",
        "title": "%command.trilium_openInBrowser.title%",
        "icon": "$(browser)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openInBrowserExternal",
        "title": "%command.trilium_openInBrowserExternal.title%",
        "icon": "$(link-external)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openFile",
        "title": "%command.trilium_openFile.title%",
        "icon": "$(go-to-file)",
        "category": "Trilium"
      },
      {
        "command": "trilium.downloadFile",
        "title": "%command.trilium_downloadFile.title%",
        "icon": "$(cloud-download)",
        "category": "Trilium"
      },
      {
        "command": "trilium.renameNote",
        "title": "%command.trilium_renameNote.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteText",
        "title": "%command.trilium_createNoteText.title%",
        "icon": "$(edit)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteCode",
        "title": "%command.trilium_createNoteCode.title%",
        "icon": "$(code)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteMermaid",
        "title": "%command.trilium_createNoteMermaid.title%",
        "icon": "$(type-hierarchy)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteCanvas",
        "title": "%command.trilium_createNoteCanvas.title%",
        "icon": "$(symbol-misc)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteMindMap",
        "title": "%command.trilium_createNoteMindMap.title%",
        "icon": "$(type-hierarchy-sub)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteWithContent",
        "title": "%command.trilium_createNoteWithContent.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.importNotes",
        "title": "%command.trilium_importNotes.title%",
        "icon": "$(cloud-upload)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openTodayNote",
        "title": "%command.trilium_openTodayNote.title%",
        "icon": "$(calendar)",
        "category": "Trilium"
      },
      {
        "command": "trilium.deleteNote",
        "title": "%command.trilium_deleteNote.title%",
        "icon": "$(trash)",
        "category": "Trilium"
      },
      {
        "command": "trilium.copyNoteId",
        "title": "%command.trilium_copyNoteId.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.copyNoteUrl",
        "title": "%command.trilium_copyNoteUrl.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.openCalendarNote",
        "title": "%command.trilium_openCalendarNote.title%",
        "icon": "$(calendar-clock)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openInboxNote",
        "title": "%command.trilium_openInboxNote.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.openWeekNote",
        "title": "%command.trilium_openWeekNote.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMonthNote",
        "title": "%command.trilium_openMonthNote.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.openYearNote",
        "title": "%command.trilium_openYearNote.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.searchNotes",
        "title": "%command.trilium_searchNotes.title%",
        "icon": "$(search)",
        "category": "Trilium"
      },
      {
        "command": "trilium.filterTree",
        "title": "%command.trilium_filterTree.title%",
        "icon": "$(filter)",
        "category": "Trilium"
      },
      {
        "command": "trilium.clearTreeFilter",
        "title": "%command.trilium_clearTreeFilter.title%",
        "icon": "$(filter-filled)",
        "category": "Trilium"
      },
      {
        "command": "trilium.showRevisions",
        "title": "%command.trilium_showRevisions.title%",
        "icon": "$(history)",
        "category": "Trilium"
      },
      {
        "command": "trilium.cloneNote",
        "title": "%command.trilium_cloneNote.title%",
        "icon": "$(copy)",
        "category": "Trilium"
      },
      {
        "command": "trilium.moveNote",
        "title": "%command.trilium_moveNote.title%",
        "icon": "$(arrow-right)",
        "category": "Trilium"
      },
      {
        "command": "trilium.reorderChildren",
        "title": "%command.trilium_reorderChildren.title%",
        "icon": "$(list-ordered)",
        "category": "Trilium"
      },
      {
        "command": "trilium.exportSubtree",
        "title": "%command.trilium_exportSubtree.title%",
        "icon": "$(package)",
        "category": "Trilium"
      },
      {
        "command": "trilium.viewAttributes",
        "title": "%command.trilium_viewAttributes.title%",
        "icon": "$(symbol-property)",
        "category": "Trilium"
      },
      {
        "command": "trilium.clearRecentNotes",
        "title": "%command.trilium_clearRecentNotes.title%",
        "icon": "$(clear-all)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNoteById",
        "title": "%command.trilium_openNoteById.title%",
        "category": "Trilium"
      },
      {
        "command": "trilium.revealInTree",
        "title": "%command.trilium_revealInTree.title%",
        "icon": "$(list-tree)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openParent",
        "title": "%command.trilium_openParent.title%",
        "icon": "$(arrow-up)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMindMap",
        "title": "%command.trilium_openMindMap.title%",
        "icon": "$(open-preview)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMindMapJson",
        "title": "%command.trilium_openMindMapJson.title%",
        "icon": "$(json)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMermaid",
        "title": "%command.trilium_openMermaid.title%",
        "icon": "$(open-preview)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMermaidSource",
        "title": "%command.trilium_openMermaidSource.title%",
        "icon": "$(code)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openCanvas",
        "title": "%command.trilium_openCanvas.title%",
        "icon": "$(open-preview)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openCanvasJson",
        "title": "%command.trilium_openCanvasJson.title%",
        "icon": "$(json)",
        "category": "Trilium"
      }
    ],
    "submenus": [
      {
        "id": "trilium.newNoteSubmenu",
        "label": "%submenu.trilium.newNoteSubmenu.label%",
        "icon": "$(add)"
      },
      {
        "id": "trilium.openAsSubmenu",
        "label": "%submenu.trilium.openAsSubmenu.label%",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "view/title/context": [
        {
          "command": "trilium.createNote",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "trilium.clearRecentNotes",
          "when": "view == triliumRecentNotes",
          "group": "navigation"
        },
        {
          "command": "trilium.searchNotes",
          "when": "view == triliumNoteTree",
          "group": "navigation@0"
        },
        {
          "command": "trilium.clearTreeFilter",
          "when": "view == triliumNoteTree && trilium.treeFiltered",
          "group": "navigation@1"
        },
        {
          "command": "trilium.filterTree",
          "when": "view == triliumNoteTree && !trilium.treeFiltered",
          "group": "navigation@1"
        },
        {
          "command": "trilium.createNote",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        },
        {
          "command": "trilium.importNotes",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        },
        {
          "command": "trilium.openTodayNote",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        },
        {
          "command": "trilium.refresh",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        }
      ],
      "trilium.newNoteSubmenu": [
        {
          "command": "trilium.createNoteText",
          "group": "types@1"
        },
        {
          "command": "trilium.createNoteCode",
          "group": "types@2"
        },
        {
          "command": "trilium.createNoteMermaid",
          "group": "types@3"
        },
        {
          "command": "trilium.createNoteCanvas",
          "group": "types@4"
        },
        {
          "command": "trilium.createNoteMindMap",
          "group": "types@5"
        }
      ],
      "trilium.openAsSubmenu": [
        {
          "command": "trilium.openNoteAsMarkdown",
          "group": "formats@1"
        },
        {
          "command": "trilium.openNoteAsHtml",
          "group": "formats@2"
        }
      ],
      "view/item/context": [
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteText",
          "group": "inline"
        },
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteCode",
          "group": "inline"
        },
        {
          "command": "trilium.openMermaid",
          "when": "viewItem == noteMermaid",
          "group": "inline"
        },
        {
          "command": "trilium.openCanvas",
          "when": "viewItem == noteCanvas",
          "group": "inline"
        },
        {
          "command": "trilium.openMindMap",
          "when": "viewItem == noteMindMap",
          "group": "inline"
        },
        {
          "command": "trilium.openMindMapJson",
          "when": "viewItem == noteMindMap",
          "group": "inline"
        },
        {
          "command": "trilium.openFile",
          "when": "viewItem == noteFile",
          "group": "inline"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteExternal",
          "group": "inline"
        },
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteText",
          "group": "navigation@1"
        },
        {
          "submenu": "trilium.openAsSubmenu",
          "when": "viewItem == noteText",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteCode",
          "group": "navigation@1"
        },
        {
          "command": "trilium.openMermaid",
          "when": "viewItem == noteMermaid",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openMermaidSource",
          "when": "viewItem == noteMermaid",
          "group": "navigation@2.1"
        },
        {
          "command": "trilium.openCanvas",
          "when": "viewItem == noteCanvas",
          "group": "navigation@2.2"
        },
        {
          "command": "trilium.openCanvasJson",
          "when": "viewItem == noteCanvas",
          "group": "navigation@2.3"
        },
        {
          "command": "trilium.openMindMap",
          "when": "viewItem == noteMindMap",
          "group": "navigation@1"
        },
        {
          "command": "trilium.openMindMapJson",
          "when": "viewItem == noteMindMap",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openFile",
          "when": "viewItem == noteFile",
          "group": "navigation@1"
        },
        {
          "command": "trilium.downloadFile",
          "when": "viewItem == noteFile",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteText",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteCode",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteMermaid",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteCanvas",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteFile",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteMermaid",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteCanvas",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteCode",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteFile",
          "group": "navigation@4"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteMermaid",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteCanvas",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteExternal",
          "group": "navigation@2"
        },
        {
          "command": "trilium.viewAttributes",
          "when": "viewItem =~ /^note(Text|Code|MindMap|File|External)$/",
          "group": "navigation@9"
        },
        {
          "submenu": "trilium.newNoteSubmenu",
          "when": "viewItem =~ /^note(Text|Code|MindMap|File|External)$/",
          "group": "1_modification@1"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteText",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteCode",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteFile",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteExternal",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteMindMap",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.deleteNote",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "2_delete@1"
        },
        {
          "command": "trilium.copyNoteId",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "9_copy@1"
        },
        {
          "command": "trilium.copyNoteUrl",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "9_copy@2"
        },
        {
          "command": "trilium.showRevisions",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@1"
        },
        {
          "command": "trilium.cloneNote",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@2"
        },
        {
          "command": "trilium.moveNote",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@3"
        },
        {
          "command": "trilium.reorderChildren",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@3.5"
        },
        {
          "command": "trilium.exportSubtree",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "trilium.revealInTree",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@20"
        },
        {
          "command": "trilium.openParent",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@21"
        }
      ],
      "editor/title": [
        {
          "command": "trilium.revealInTree",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@20"
        },
        {
          "command": "trilium.openParent",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@21"
        },
        {
          "command": "trilium.openMindMap",
          "when": "trilium.activeNoteType == 'mindMap'",
          "group": "navigation@10"
        },
        {
          "command": "trilium.openMermaid",
          "when": "trilium.activeNoteType == 'mermaid'",
          "group": "navigation@10"
        },
        {
          "command": "trilium.openMermaidSource",
          "when": "trilium.activeNoteType == 'mermaid'",
          "group": "navigation@11"
        },
        {
          "command": "trilium.openCanvas",
          "when": "trilium.activeNoteType == 'canvas'",
          "group": "navigation@10"
        },
        {
          "command": "trilium.openCanvasJson",
          "when": "trilium.activeNoteType == 'canvas'",
          "group": "navigation@11"
        }
      ]
    },
    "keybindings": [
      {
        "command": "trilium.renameNote",
        "key": "F2",
        "when": "focusedView == triliumNoteTree || view == triliumNoteTree"
      }
    ],
    "configuration": {
      "title": "Trilium Notes",
      "properties": {
        "trilium.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "%config.trilium_serverUrl.description%"
        },
        "trilium.rootNoteId": {
          "type": "string",
          "default": "root",
          "description": "%config.trilium_rootNoteId.description%"
        },
        "trilium.editor.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 32,
          "description": "%config.trilium_editor_fontSize.description%"
        },
        "trilium.editor.spellcheck": {
          "type": "boolean",
          "default": false,
          "description": "%config.trilium_editor_spellcheck.description%"
        },
        "trilium.editor.highlightTheme": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "github",
            "atom-one-dark",
            "solarized-light"
          ],
          "description": "%config.trilium_editor_highlightTheme.description%"
        },
        "trilium.recentNotesMaxCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.trilium_recentNotesMaxCount.description%"
        },
        "trilium.autoRevealInTreeOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "%config.trilium_autoRevealInTreeOnOpen.description%"
        },
        "trilium.autoRefreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 600,
          "description": "%config.trilium_autoRefreshIntervalSeconds.description%"
        },
        "trilium.autoRefreshMaxConsecutiveFailures": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.trilium_autoRefreshMaxConsecutiveFailures.description%"
        },
        "trilium.autoRefreshWarnAfterFailures": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.trilium_autoRefreshWarnAfterFailures.description%"
        }
      }
    }
  },
  "scripts": {
    "bootstrap:build": "node scripts/bootstrap-build.mjs",
    "check:react-deps": "node scripts/check-react-deps.mjs",
    "check:vscode-version": "node scripts/check-vscode-version.mjs",
    "prebuild": "node scripts/download-trilium-plugins.mjs",
    "release:sync-version": "node scripts/set-package-version.mjs",
    "vscode:prepublish": "npm run prebuild && node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "build:prod": "npm run prebuild && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc --noEmit",
    "compile:tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile:tests && mocha",
    "test:integration": "npm run build && npm run compile:tests && vscode-test",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "package:vsix": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ckeditor5": "^49.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.0",
    "tar": "^7.5.22",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "bootstrap": "^5.3.8",
    "boxicons": "^2.1.4",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.0.11",
    "mathlive": "^0.111.0",
    "mermaid": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4"
  }
