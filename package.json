{
  "name": "trilium-notes",
  "displayName": "Trilium Notes",
  "description": "Browse and edit Trilium Notes directly in VS Code via ETAPI",
  "version": "2.0.0",
  "publisher": "NemesisRE",
  "icon": "media/icon.png",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/NemesisRE/vscode-trilium-extension#readme",
  "bugs": {
    "url": "https://github.com/NemesisRE/vscode-trilium-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NemesisRE/vscode-trilium-extension"
  },
  "files": [
    "out/extension.js",
    "out/ckeditor/**",
    "out/webviews/**",
    "out/boxicons/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "trilium",
    "trilium-notes",
    "notes",
    "knowledge-base",
    "pkm",
    "zettelkasten",
    "etapi"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "trilium.textEditor",
        "displayName": "Trilium Text Editor",
        "selector": [
          {
            "filenamePattern": "*.trilium-text"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trilium",
          "title": "Trilium Notes",
          "icon": "media/trilium.svg"
        }
      ]
    },
    "views": {
      "trilium": [
        {
          "id": "triliumNoteTree",
          "name": "Notes",
          "icon": "media/trilium.svg",
          "contextualTitle": "Trilium Notes"
        },
        {
          "id": "triliumNoteAttributes",
          "name": "Attributes",
          "type": "webview",
          "icon": "media/trilium.svg",
          "contextualTitle": "Trilium Notes"
        },
        {
          "id": "triliumRecentNotes",
          "name": "Recent Notes",
          "icon": "media/trilium.svg",
          "contextualTitle": "Trilium Notes"
        },
        {
          "id": "triliumBacklinks",
          "name": "Backlinks",
          "icon": "media/trilium.svg",
          "contextualTitle": "Trilium Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "trilium.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Trilium"
      },
      {
        "command": "trilium.connect",
        "title": "Connect to Trilium Server",
        "icon": "$(debug-disconnect)",
        "category": "Trilium"
      },
      {
        "command": "trilium.reconnect",
        "title": "Reconnect to Trilium Server",
        "icon": "$(database)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNote",
        "title": "Open Note",
        "icon": "$(edit)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNoteAsHtml",
        "title": "Open as HTML",
        "icon": "$(file-code)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNoteAsMarkdown",
        "title": "Open as Markdown",
        "icon": "$(markdown)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNote",
        "title": "New Note",
        "icon": "$(add)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(browser)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openInBrowserExternal",
        "title": "Open in External Browser",
        "icon": "$(link-external)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)",
        "category": "Trilium"
      },
      {
        "command": "trilium.downloadFile",
        "title": "Download File",
        "icon": "$(cloud-download)",
        "category": "Trilium"
      },
      {
        "command": "trilium.renameNote",
        "title": "Rename Note",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteText",
        "title": "New Text Note",
        "icon": "$(edit)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteCode",
        "title": "New Code Note",
        "icon": "$(code)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteMermaid",
        "title": "New Mermaid Diagram",
        "icon": "$(type-hierarchy)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteCanvas",
        "title": "New Canvas (Excalidraw)",
        "icon": "$(symbol-misc)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteMindMap",
        "title": "New Mind Map Note",
        "icon": "$(type-hierarchy-sub)",
        "category": "Trilium"
      },
      {
        "command": "trilium.createNoteWithContent",
        "title": "Create Note With Content (programmatic)",
        "category": "Trilium"
      },
      {
        "command": "trilium.importNotes",
        "title": "Import Notes from JSON",
        "icon": "$(cloud-upload)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openTodayNote",
        "title": "Open Today's Journal Note",
        "icon": "$(calendar)",
        "category": "Trilium"
      },
      {
        "command": "trilium.deleteNote",
        "title": "Delete Note",
        "icon": "$(trash)",
        "category": "Trilium"
      },
      {
        "command": "trilium.copyNoteId",
        "title": "Copy Note ID",
        "category": "Trilium"
      },
      {
        "command": "trilium.copyNoteUrl",
        "title": "Copy Trilium URL",
        "category": "Trilium"
      },
      {
        "command": "trilium.openCalendarNote",
        "title": "Open Calendar Note...",
        "icon": "$(calendar-clock)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openInboxNote",
        "title": "Open Inbox Note",
        "category": "Trilium"
      },
      {
        "command": "trilium.openWeekNote",
        "title": "Open This Week's Note",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMonthNote",
        "title": "Open This Month's Note",
        "category": "Trilium"
      },
      {
        "command": "trilium.openYearNote",
        "title": "Open This Year's Note",
        "category": "Trilium"
      },
      {
        "command": "trilium.searchNotes",
        "title": "Search Notes...",
        "icon": "$(search)",
        "category": "Trilium"
      },
      {
        "command": "trilium.filterTree",
        "title": "Filter Tree...",
        "icon": "$(filter)",
        "category": "Trilium"
      },
      {
        "command": "trilium.clearTreeFilter",
        "title": "Clear Tree Filter",
        "icon": "$(filter-filled)",
        "category": "Trilium"
      },
      {
        "command": "trilium.showRevisions",
        "title": "Show Note Revisions...",
        "icon": "$(history)",
        "category": "Trilium"
      },
      {
        "command": "trilium.cloneNote",
        "title": "Clone Note...",
        "icon": "$(copy)",
        "category": "Trilium"
      },
      {
        "command": "trilium.moveNote",
        "title": "Move Note...",
        "icon": "$(arrow-right)",
        "category": "Trilium"
      },
      {
        "command": "trilium.reorderChildren",
        "title": "Reorder Child Notes...",
        "icon": "$(list-ordered)",
        "category": "Trilium"
      },
      {
        "command": "trilium.exportSubtree",
        "title": "Export Subtree...",
        "icon": "$(package)",
        "category": "Trilium"
      },
      {
        "command": "trilium.viewAttributes",
        "title": "View Attributes",
        "icon": "$(symbol-property)",
        "category": "Trilium"
      },
      {
        "command": "trilium.clearRecentNotes",
        "title": "Clear Recent Notes",
        "icon": "$(clear-all)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openNoteById",
        "title": "Open Note by ID (internal)",
        "category": "Trilium"
      },
      {
        "command": "trilium.revealInTree",
        "title": "Reveal Note in Tree",
        "icon": "$(list-tree)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openParent",
        "title": "Open Parent Note",
        "icon": "$(arrow-up)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMindMap",
        "title": "Open Mind Map",
        "icon": "$(open-preview)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMindMapJson",
        "title": "Open Mind Map JSON",
        "icon": "$(json)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMermaid",
        "title": "Open Mermaid Diagram",
        "icon": "$(open-preview)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openMermaidSource",
        "title": "Open Mermaid Source (.mmd)",
        "icon": "$(code)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openCanvas",
        "title": "Open Canvas",
        "icon": "$(open-preview)",
        "category": "Trilium"
      },
      {
        "command": "trilium.openCanvasJson",
        "title": "Open Canvas JSON (.excalidraw)",
        "icon": "$(json)",
        "category": "Trilium"
      }
    ],
    "submenus": [
      {
        "id": "trilium.newNoteSubmenu",
        "label": "New Note...",
        "icon": "$(add)"
      },
      {
        "id": "trilium.openAsSubmenu",
        "label": "Open as...",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "view/title/context": [
        {
          "command": "trilium.createNote",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "trilium.clearRecentNotes",
          "when": "view == triliumRecentNotes",
          "group": "navigation"
        },
        {
          "command": "trilium.searchNotes",
          "when": "view == triliumNoteTree",
          "group": "navigation@0"
        },
        {
          "command": "trilium.clearTreeFilter",
          "when": "view == triliumNoteTree && trilium.treeFiltered",
          "group": "navigation@1"
        },
        {
          "command": "trilium.filterTree",
          "when": "view == triliumNoteTree && !trilium.treeFiltered",
          "group": "navigation@1"
        },
        {
          "command": "trilium.createNote",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        },
        {
          "command": "trilium.importNotes",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        },
        {
          "command": "trilium.openTodayNote",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        },
        {
          "command": "trilium.refresh",
          "when": "view == triliumNoteTree",
          "group": "navigation"
        }
      ],
      "trilium.newNoteSubmenu": [
        {
          "command": "trilium.createNoteText",
          "group": "types@1"
        },
        {
          "command": "trilium.createNoteCode",
          "group": "types@2"
        },
        {
          "command": "trilium.createNoteMermaid",
          "group": "types@3"
        },
        {
          "command": "trilium.createNoteCanvas",
          "group": "types@4"
        },
        {
          "command": "trilium.createNoteMindMap",
          "group": "types@5"
        }
      ],
      "trilium.openAsSubmenu": [
        {
          "command": "trilium.openNoteAsMarkdown",
          "group": "formats@1"
        },
        {
          "command": "trilium.openNoteAsHtml",
          "group": "formats@2"
        }
      ],
      "view/item/context": [
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteText",
          "group": "inline"
        },
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteCode",
          "group": "inline"
        },
        {
          "command": "trilium.openMermaid",
          "when": "viewItem == noteMermaid",
          "group": "inline"
        },
        {
          "command": "trilium.openCanvas",
          "when": "viewItem == noteCanvas",
          "group": "inline"
        },
        {
          "command": "trilium.openMindMap",
          "when": "viewItem == noteMindMap",
          "group": "inline"
        },
        {
          "command": "trilium.openMindMapJson",
          "when": "viewItem == noteMindMap",
          "group": "inline"
        },
        {
          "command": "trilium.openFile",
          "when": "viewItem == noteFile",
          "group": "inline"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteExternal",
          "group": "inline"
        },
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteText",
          "group": "navigation@1"
        },
        {
          "submenu": "trilium.openAsSubmenu",
          "when": "viewItem == noteText",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openNote",
          "when": "viewItem == noteCode",
          "group": "navigation@1"
        },
        {
          "command": "trilium.openMermaid",
          "when": "viewItem == noteMermaid",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openMermaidSource",
          "when": "viewItem == noteMermaid",
          "group": "navigation@2.1"
        },
        {
          "command": "trilium.openCanvas",
          "when": "viewItem == noteCanvas",
          "group": "navigation@2.2"
        },
        {
          "command": "trilium.openCanvasJson",
          "when": "viewItem == noteCanvas",
          "group": "navigation@2.3"
        },
        {
          "command": "trilium.openMindMap",
          "when": "viewItem == noteMindMap",
          "group": "navigation@1"
        },
        {
          "command": "trilium.openMindMapJson",
          "when": "viewItem == noteMindMap",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openFile",
          "when": "viewItem == noteFile",
          "group": "navigation@1"
        },
        {
          "command": "trilium.downloadFile",
          "when": "viewItem == noteFile",
          "group": "navigation@2"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteText",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteCode",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteMermaid",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteCanvas",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem == noteFile",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteMermaid",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteCanvas",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowser",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "navigation@3.9"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteCode",
          "group": "navigation@4"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteFile",
          "group": "navigation@4"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteMermaid",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteCanvas",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.openInBrowserExternal",
          "when": "viewItem == noteExternal",
          "group": "navigation@2"
        },
        {
          "command": "trilium.viewAttributes",
          "when": "viewItem =~ /^note(Text|Code|MindMap|File|External)$/",
          "group": "navigation@9"
        },
        {
          "submenu": "trilium.newNoteSubmenu",
          "when": "viewItem =~ /^note(Text|Code|MindMap|File|External)$/",
          "group": "1_modification@1"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteText",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteCode",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteFile",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteExternal",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.renameNote",
          "when": "viewItem == noteMindMap",
          "group": "1_modification@2"
        },
        {
          "command": "trilium.deleteNote",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "2_delete@1"
        },
        {
          "command": "trilium.copyNoteId",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "9_copy@1"
        },
        {
          "command": "trilium.copyNoteUrl",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "9_copy@2"
        },
        {
          "command": "trilium.showRevisions",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@1"
        },
        {
          "command": "trilium.cloneNote",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@2"
        },
        {
          "command": "trilium.moveNote",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@3"
        },
        {
          "command": "trilium.reorderChildren",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@3.5"
        },
        {
          "command": "trilium.exportSubtree",
          "when": "viewItem =~ /^note(Text|Code|Mermaid|Canvas|MindMap|File|External)$/",
          "group": "3_history@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "trilium.revealInTree",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@20"
        },
        {
          "command": "trilium.openParent",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@21"
        }
      ],
      "editor/title": [
        {
          "command": "trilium.revealInTree",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@20"
        },
        {
          "command": "trilium.openParent",
          "when": "resourceScheme == trilium-text || trilium.activeNoteType == 'mindMap' || trilium.activeNoteType == 'mermaid' || trilium.activeNoteType == 'canvas'",
          "group": "navigation@21"
        },
        {
          "command": "trilium.openMindMap",
          "when": "trilium.activeNoteType == 'mindMap'",
          "group": "navigation@10"
        },
        {
          "command": "trilium.openMermaid",
          "when": "trilium.activeNoteType == 'mermaid'",
          "group": "navigation@10"
        },
        {
          "command": "trilium.openMermaidSource",
          "when": "trilium.activeNoteType == 'mermaid'",
          "group": "navigation@11"
        },
        {
          "command": "trilium.openCanvas",
          "when": "trilium.activeNoteType == 'canvas'",
          "group": "navigation@10"
        },
        {
          "command": "trilium.openCanvasJson",
          "when": "trilium.activeNoteType == 'canvas'",
          "group": "navigation@11"
        }
      ]
    },
    "keybindings": [
      {
        "command": "trilium.renameNote",
        "key": "F2",
        "when": "focusedView == triliumNoteTree || view == triliumNoteTree"
      }
    ],
    "configuration": {
      "title": "Trilium Notes",
      "properties": {
        "trilium.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "URL of the Trilium Notes server (e.g. http://localhost:8080)"
        },
        "trilium.rootNoteId": {
          "type": "string",
          "default": "root",
          "description": "Note ID to use as the root of the Trilium tree view. Defaults to 'root'. Change this to scope the tree to a specific subtree (workspace / hoisting equivalent)."
        },
        "trilium.editor.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 32,
          "description": "Font size in pixels for the CKEditor content area."
        },
        "trilium.editor.spellcheck": {
          "type": "boolean",
          "default": false,
          "description": "Enable the browser's built-in spellcheck in the CKEditor content area."
        },
        "trilium.editor.highlightTheme": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "github",
            "atom-one-dark",
            "solarized-light"
          ],
          "description": "Theme for code block syntax highlighting in the editor."
        },
        "trilium.recentNotesMaxCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of recently opened notes to show in the Recent Notes view."
        },
        "trilium.autoRevealInTreeOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reveal and focus a note in the tree after opening it in an editor."
        },
        "trilium.autoRefreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 600,
          "description": "How often (in seconds) to check for external changes to open notes and refresh them. Set to 0 to disable."
        },
        "trilium.autoRefreshMaxConsecutiveFailures": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum consecutive auto-refresh failures before an open note is untracked from refresh polling."
        },
        "trilium.autoRefreshWarnAfterFailures": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 50,
          "description": "Show a retry/reconnect warning after this many consecutive auto-refresh failures (and every N failures after)."
        }
      }
    }
  },
  "scripts": {
    "bootstrap:build": "node scripts/bootstrap-build.mjs",
