{
  "name": "trilium-notes",
  "displayName": "Trilium Notes",
  "description": "Browse and edit Trilium Notes directly in VS Code via ETAPI",
  "version": "1.3.2",
  "publisher": "NemesisRE",
  "icon": "media/icon.png",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/NemesisRE/vscode-trilium-extension#readme",
  "bugs": {
    "url": "https://github.com/NemesisRE/vscode-trilium-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NemesisRE/vscode-trilium-extension"
  },
  "files": [
    "out/extension.js",
    "out/ckeditor/**",
    "out/boxicons/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "trilium",
    "trilium-notes",
    "notes",
    "knowledge-base",
    "pkm",
    "zettelkasten",
    "etapi"
