    "languageModelTools": [
      {
        "name": "trilium_createNote",
        "displayName": "Create Trilium Note",
        "toolReferenceName": "createTriliumNote",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Creates a single note in Trilium Notes under parentNoteId. If parentNoteId is unknown, first use trilium_searchNotes, trilium_getNoteContext, and/or trilium_listChildren to locate the desired parent. Use this for single-note results. For documentation sets or multiple related pages, prefer trilium_importNotes instead. Supports types: text (rich HTML), code (source code with language), mermaid (diagram), canvas (Excalidraw drawing). Returns the new noteId.",
        "tags": [
          "trilium",
          "notes",
          "create"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "title",
            "type",
            "content"
          ],
          "properties": {
            "parentNoteId": {
              "type": "string",
              "description": "ID of the parent note. Use 'root' to create at the top level. Omit to default to 'root'."
            },
            "title": {
              "type": "string",
              "description": "Title of the new note."
            },
            "type": {
              "type": "string",
              "enum": [
                "text",
                "code",
                "mermaid",
                "canvas"
              ],
              "description": "Note type. 'text'=rich HTML, 'code'=source code, 'mermaid'=Mermaid diagram syntax, 'canvas'=Excalidraw JSON."
            },
            "content": {
              "type": "string",
              "description": "Note body. For 'text': CKEditor HTML (e.g. '<p>Hello</p>'). For 'mermaid': raw Mermaid syntax (no code fences). For 'canvas': Excalidraw JSON string. For 'code': raw source code."
            },
            "mime": {
              "type": "string",
              "description": "MIME type — required for 'code' notes (e.g. 'text/javascript', 'text/x-python'). Ignored for other types."
            }
          }
        }
      },
      {
        "name": "trilium_importNotes",
        "displayName": "Import Notes Tree to Trilium",
        "toolReferenceName": "importTriliumNotes",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Recursively creates an entire hierarchy of notes in Trilium Notes from a JSON spec. Use this when the user asks to create documentation, a set of notes, or any multi-level note structure such as a homelab guide with overview and sub-pages. Resolve the destination first with trilium_searchNotes and/or trilium_getNoteContext. Returns the total number of notes created.",
        "tags": [
          "trilium",
          "notes",
          "import",
          "documentation"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "notes"
          ],
          "properties": {
            "parentNoteId": {
              "type": "string",
              "description": "ID of the parent note to create everything under. Use 'root' for the top level. Omit to default to 'root'."
            },
            "notes": {
              "type": "array",
              "description": "Array of NoteImportSpec objects to create recursively.",
              "items": {
                "$ref": "#/$defs/NoteImportSpec"
              }
            }
          },
          "$defs": {
            "NoteImportSpec": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Note title."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "code",
                    "mermaid",
                    "canvas"
                  ],
                  "description": "Note type. Defaults to 'text'."
                },
                "mime": {
                  "type": "string",
                  "description": "MIME type for code notes (e.g. 'text/javascript')."
                },
                "content": {
                  "type": "string",
                  "description": "Note body (HTML for text, Mermaid syntax for mermaid, Excalidraw JSON for canvas, raw source for code)."
                },
                "children": {
                  "type": "array",
                  "description": "Child notes to create recursively under this note.",
                  "items": {
                    "$ref": "#/$defs/NoteImportSpec"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "trilium_stageDraftNotes",
        "displayName": "Stage Trilium Draft Notes",
        "toolReferenceName": "stageTriliumDraftNotes",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Creates new notes in Trilium with placeholder server content, opens them as dirty local drafts in VS Code, and defers saving generated content until the user explicitly confirms. Use this for documentation-generation workflows where the target section defines the subtree boundary. Notes may be created directly under that section or deeper within its subsections, and nested child notes are supported.",
        "tags": [
          "trilium",
          "notes",
          "draft",
          "documentation"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "parentNoteId",
            "notes"
          ],
          "properties": {
            "parentNoteId": {
              "type": "string",
              "description": "The Trilium note ID that defines the target subtree boundary for the new draft notes."
            },
            "notes": {
              "type": "array",
              "description": "Array of staged draft note specs to create recursively within the target subtree. All content must be valid HTML for text notes.",
              "items": {
                "$ref": "#/$defs/DraftNoteSpec"
              }
            }
          },
          "$defs": {
            "DraftNoteSpec": {
              "type": "object",
              "required": [
                "title",
                "content"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Child note title."
                },
                "content": {
                  "type": "string",
                  "description": "Draft HTML content for this child note."
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DraftNoteSpec"
                  },
                  "description": "Nested child notes to stage under this new note."
                }
              }
            }
          }
        }
      },
      {
        "name": "trilium_searchNotes",
        "displayName": "Search Trilium Notes",
        "toolReferenceName": "searchTriliumNotes",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Searches notes in Trilium by a text query. Returns a list of matching notes with noteId, title, type, full path, and parent noteId. Use this to find likely destination notes or related context before reading or writing.",
        "tags": [
          "trilium",
          "notes",
          "search"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "description": "Full-text search query."
            },
            "ancestorNoteId": {
              "type": "string",
              "description": "Restrict the search to descendants of this note ID. Omit to search all notes."
            },
            "limit": {
              "type": "number",
              "description": "Maximum number of results to return (default: 20, max: 100)."
            }
          }
        }
      },
      {
        "name": "trilium_getNoteContext",
        "displayName": "Get Trilium Note Context",
        "toolReferenceName": "getTriliumNoteContext",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Returns structured context for a Trilium note: full ancestor path, note IDs along that path, attributes, and a summary of direct children. Use this after resolving a destination note to understand where new content should be written and how the subtree is organized.",
        "tags": [
          "trilium",
          "notes",
          "context",
          "navigation"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "noteId"
          ],
          "properties": {
            "noteId": {
              "type": "string",
              "description": "The ID of the note whose Trilium context should be returned."
            },
            "childLimit": {
              "type": "number",
              "description": "Maximum number of direct child notes to include in the summary (default: 12)."
            }
          }
        }
      },
      {
        "name": "trilium_readNote",
        "displayName": "Read Trilium Note Content",
        "toolReferenceName": "readTriliumNote",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Reads the content of a specific Trilium note by its noteId. Returns the note title, type, path, and content as plain text (HTML stripped). Use this after trilium_searchNotes or trilium_getNoteContext to inspect the destination note or nearby notes before creating documentation.",
        "tags": [
          "trilium",
          "notes",
          "read"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "noteId"
          ],
          "properties": {
            "noteId": {
              "type": "string",
              "description": "The ID of the note to read."
            }
          }
        }
      },
      {
        "name": "trilium_listChildren",
        "displayName": "List Trilium Note Children",
        "toolReferenceName": "listTriliumNoteChildren",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Lists the direct child notes of a given Trilium note. Returns an array of noteId, title, and type. Use this to navigate the note tree or find child notes before reading them.",
        "tags": [
          "trilium",
          "notes",
          "navigate"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "noteId"
          ],
          "properties": {
            "noteId": {
              "type": "string",
              "description": "The ID of the parent note whose children should be listed. Use 'root' for the top level."
            }
          }
        }
      },
      {
        "name": "trilium_updateNoteContent",
        "displayName": "Update Trilium Note Content",
        "toolReferenceName": "updateTriliumNoteContent",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Replaces the full content of an existing Trilium note identified by noteId. Use this when the user asks to rewrite or overwrite a note.",
        "tags": [
          "trilium",
          "notes",
          "update",
          "edit"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "noteId",
            "content"
          ],
          "properties": {
            "noteId": {
              "type": "string",
              "description": "The ID of the note to update."
            },
            "content": {
              "type": "string",
              "description": "New full note content. For text notes provide HTML; for code notes provide raw source; for mermaid provide Mermaid syntax; for canvas provide Excalidraw JSON."
            }
          }
        }
      },
      {
        "name": "trilium_appendToNote",
        "displayName": "Append To Trilium Note",
        "toolReferenceName": "appendToTriliumNote",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Appends content to an existing Trilium note identified by noteId. Use this for journaling, adding sections, or incremental updates.",
        "tags": [
          "trilium",
          "notes",
          "append",
          "edit"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "noteId",
            "content"
          ],
          "properties": {
            "noteId": {
              "type": "string",
              "description": "The ID of the note to append to."
            },
            "content": {
              "type": "string",
              "description": "Content to append. Match note format (HTML for text notes, raw source for code notes, Mermaid syntax for mermaid notes, JSON for canvas notes)."
            },
            "separator": {
              "type": "string",
              "description": "Optional separator inserted between existing and appended content. Defaults to empty string for text notes and newline for others."
            }
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "trilium.renameNote",
        "key": "F2",
        "when": "focusedView == triliumNoteTree || view == triliumNoteTree"
      }
    ],
    "configuration": {
      "title": "Trilium Notes",
      "properties": {
        "trilium.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "URL of the Trilium Notes server (e.g. http://localhost:8080)"
        },
        "trilium.rootNoteId": {
          "type": "string",
          "default": "root",
          "description": "Note ID to use as the root of the Trilium tree view. Defaults to 'root'. Change this to scope the tree to a specific subtree (workspace / hoisting equivalent)."
        },
        "trilium.editor.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 32,
          "description": "Font size in pixels for the CKEditor content area."
        },
        "trilium.editor.spellcheck": {
          "type": "boolean",
          "default": false,
          "description": "Enable the browser's built-in spellcheck in the CKEditor content area."
        },
        "trilium.editor.highlightTheme": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "github",
            "atom-one-dark",
            "solarized-light"
          ],
          "description": "Theme for code block syntax highlighting in the editor."
        },
        "trilium.recentNotesMaxCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of recently opened notes to show in the Recent Notes view."
        },
        "trilium.autoRevealInTreeOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reveal and focus a note in the tree after opening it in an editor."
        },
        "trilium.autoRefreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 600,
          "description": "How often (in seconds) to check for external changes to open notes and refresh them. Set to 0 to disable."
        },
        "trilium.autoRefreshMaxConsecutiveFailures": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum consecutive auto-refresh failures before an open note is untracked from refresh polling."
        },
        "trilium.autoRefreshWarnAfterFailures": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 50,
          "description": "Show a retry/reconnect warning after this many consecutive auto-refresh failures (and every N failures after)."
        }
      }
    }
  },
  "scripts": {
    "prebuild": "node scripts/download-trilium-plugins.mjs",
